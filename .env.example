NODE_ENV=development
PORT=3100
HOST=127.0.0.1
DATABASE_URL=postgres://control_center:change-me@127.0.0.1:5432/control_center
DATABASE_SSL=0
TRUST_PROXY=loopback
SESSION_COOKIE_NAME=cc_session
SESSION_TTL_HOURS=8
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin123
CONTROL_CENTER_PUBLIC_URL=http://127.0.0.1:3100
SSO_TICKET_TTL_SECONDS=60
# 用于加密后台保存的 GitHub、Cloudflare、Telegram 和 Bark 凭据；生产环境必须设置并长期保留。
SETTINGS_ENCRYPTION_KEY=

# 第八阶段：永久发布页双平台工作流
PUBLISH_GITHUB_TOKEN=
PUBLISH_GITHUB_BRANCH=gh-pages
PUBLISH_CLOUDFLARE_API_TOKEN=
PUBLISH_CLOUDFLARE_ACCOUNT_ID=
PUBLISH_CLOUDFLARE_BRANCH=main
# 可选；默认使用项目 var/.wrangler
PUBLISH_WRANGLER_STATE_DIR=

# 第十阶段：任务告警（Telegram 主通道，失败后转 Bark）
ALERT_SITE_NAME=星环总控
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_BARK_URL=
ALERT_TIMEOUT_MS=8000
ALERT_RETRY_DELAY_MS=1500
